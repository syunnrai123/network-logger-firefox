# ===== JetBrains / PyCharm =====
# 忽略 .idea 下本地个性化文件,仅保留共享的 .gitignore 与 inspectionProfiles
.idea/*
!.idea/.gitignore
!.idea/inspectionProfiles/
!.idea/inspectionProfiles/*
*.iml

# ===== 编辑器 =====
.vscode/
.cursor/
*.swp
*.swo
*~
*.bak

# ===== 系统文件 =====
.DS_Store
.AppleDouble
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ===== Node / web-ext =====
node_modules/
web-ext-artifacts/
.web-extension-id
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== Python（本地脚本 / PyCharm 解释器） =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.eggs/

# ===== 构建与运行时输出 =====
# web-ext / 手动打包产物、导出的 HAR,不入库
build/
dist/
*.har
*.zip
*.xpi
*.log
*.tmp
*.temp

# ===== 密钥与本地配置 =====
.env
.env.*
!.env.example
*.pem
*.key

# ===== 本地会话 / 临时转储 =====
/0903_firefox
