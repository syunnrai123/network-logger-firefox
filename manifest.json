{
   "background": {
      "persistent": true,
      "scripts": [ "background.js" ]
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "content-hook.js" ],
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_start"
   } ],
   "browser_action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "32": "icons/icon32.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup.html",
      "default_title": "Network Logger"
   },
   "browser_specific_settings": {
      "gecko": {
         "data_collection_permissions": {
            "required": [ "none" ]
         },
         "id": "network-logger-har-exporter@example.local",
         "strict_min_version": "140.0"
      },
      "gecko_android": {
         "strict_min_version": "142.0"
      }
   },
   "description": "Capture network requests across all tabs and export as a HAR file — no DevTools needed. Perfect for debugging and sharing logs.",
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
   },
   "manifest_version": 2,
   "name": "Network Logger - HAR Exporter",
   "incognito": "spanning",
   "permissions": [ "storage", "webRequest", "webRequestBlocking", "webNavigation", "downloads", "\u003Call_urls>" ],
   "version": "1.2.11",
   "web_accessible_resources": [ "page-hook.js" ]
}
